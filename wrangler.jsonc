{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tisona-api",
  "main": "deploy/cloudflare/worker.mjs",
  "compatibility_date": "2026-10-17",
  "workers_dev": true,
  "observability": { "enabled": true },
  "containers": [{
    "name": "tisona-runtime",
    "class_name": "TiSonaRuntime",
    "scheduling_policy": "durable_object",
    "images": { "app": { "dockerfile": "Dockerfile", "build_context": "." } }
  }],
  "durable_objects": { "bindings": [{ "name": "RUNTIME", "class_name": "TiSonaRuntime" }] },
  "exports": { "TiSonaRuntime": { "type": "durable-object", "storage": "sqlite", "container": "tisona-runtime" } },
  "secrets": { "required": ["TISONA_RUNTIME"] }
}
