NODE_ENV=production
RESONATE_STATE_DIR=/var/lib/resonate-cloud
RESONATE_PROJECT_ID=starter
RESONATE_PROJECT_NAME="Starter project"
RESONATE_PUBLIC_URL=https://runs.example.com
RESONATE_BIND=127.0.0.1
RESONATE_PORT=8787
RESONATE_ENGINE_BINARY=/opt/tisona/.vendor/resonate/impl/server/core/target/release/resonate
RESONATE_ENGINE_URL=http://127.0.0.1:8001
RESONATE_ENGINE_METRICS_URL=http://127.0.0.1:9091/metrics
RESONATE_DATABASE_URL_FILE=/etc/resonate-cloud/database.url
RESONATE_ENGINE_PRIVATE_KEY_FILE=/var/lib/resonate-cloud/engine-private.pem
RESONATE_ENGINE_PUBLIC_KEY_FILE=/var/lib/resonate-cloud/engine-public.pem
RESONATE_BOOTSTRAP_ADMIN_KEY_FILE=/var/lib/resonate-cloud/bootstrap-admin.key
