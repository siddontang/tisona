# Public settings only. Runtime credentials are generated in Git-ignored .local/.
# Backend service (npm run backend).
RESONATE_PUBLIC_URL=http://127.0.0.1:8788
RESONATE_PORT=8788
RESONATE_CONSOLE_URL=http://127.0.0.1:8787

# Independent Web Console (npm run console).
TISONA_API_URL=http://127.0.0.1:8788
TISONA_CONSOLE_URL=http://127.0.0.1:8787
TISONA_CONSOLE_BIND=127.0.0.1
TISONA_CONSOLE_PORT=8787
